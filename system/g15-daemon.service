[Unit]
Description=Dell G15 Control Center Daemon
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/var/opt/g15-controller/venv/bin/python /var/opt/g15-controller/src/g15_daemon.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target